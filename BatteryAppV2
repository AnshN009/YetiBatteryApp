//  CSV DOWNLOAD
// ═══════════════════════════════════════════════════════════════════
function downloadCSV(section) {
  const {times,volts,currents,power,impSamples,dt} = CHART_DATA;
  let rows=[], header='';

  if (section === 'voltage') {
    const rollV = CHART_DATA.rollV_cur || Array.from(rollingMin(new Float64Array(volts),5));
    const regV  = CHART_DATA.regV || linReg(times,volts);
    header = 'time_s,voltage_V,rolling_min_V,regression_V';
    rows = times.map((t,i)=>`${t.toFixed(3)},${volts[i].toFixed(4)},${rollV[i].toFixed(4)},${(regV.m*t+regV.b).toFixed(4)}`);

  } else if (section === 'current') {
    const safe = CHART_DATA.safeCurr||currents.map(c=>isNaN(c)?0:Math.max(0,c));
    const rollC = CHART_DATA.rollC_cur || Array.from(rollingMean(new Float64Array(safe),5));
    header = 'time_s,current_A,rolling_mean_A,is_peak';
    const peakSet = new Set(CHART_DATA.peakIdxAll_cur||[]);
    rows = times.map((t,i)=>`${t.toFixed(3)},${safe[i].toFixed(2)},${rollC[i].toFixed(2)},${peakSet.has(i)?1:0}`);

  } else if (section === 'power') {
    const safePow = power.map(p=>isNaN(p)?0:p);
    const rollP = CHART_DATA.rollP_cur || Array.from(rollingMean(new Float64Array(safePow),25));
    const regP  = CHART_DATA.regP || linReg(times,safePow);
    header = 'time_s,power_W,rolling_mean_W,regression_W';
    rows = times.map((t,i)=>`${t.toFixed(3)},${safePow[i].toFixed(1)},${rollP[i].toFixed(1)},${(regP.m*t+regP.b).toFixed(1)}`);

  } else if (section === 'impedance') {
    const rollI = CHART_DATA.rollI_cur;
    const regI  = CHART_DATA.regI;
    header = 'time_s,voltage_V,current_A,sag_V,impedance_mohm,rolling_median_mohm,regression_mohm';
    rows = impSamples.map((s,i)=>{
      const rm  = rollI ? rollI[i].toFixed(3) : '';
      const reg = regI  ? (regI.m*s.t+regI.b).toFixed(3) : '';
      return `${s.t.toFixed(3)},${s.v.toFixed(4)},${s.c.toFixed(2)},${s.sag.toFixed(4)},${s.R.toFixed(3)},${rm},${reg}`;
    });
  }

  const csv = [header, ...rows].join('\n');
  const blob = new Blob([csv], {type:'text/csv'});
  const url  = URL.createObjectURL(blob);
  const a    = Object.assign(document.createElement('a'), {href:url, download:`frc_battery_${section}.csv`});
  a.click(); URL.revokeObjectURL(url);
}

// ═══════════════════════════════════════════════════════════════════
//  DEMO DATA — synthetic match
// ═══════════════════════════════════════════════════════════════════
function runDemo() {
  setLoading('Generating demo data…');
  setTimeout(() => {
    // DS log: synthetic voltage trace
    const dsData=[], canData=[];
    let soc=0.91, t=0;
    for (let i=0; i<8000; i++) {
      const load = i<250 ? 8+Math.random()*4
                 : i<1000 ? 70+Math.sin(i*0.2)*40+(Math.random()<0.08?140:0)+Math.random()*10
                 : 52+Math.sin(i*0.055)*35+Math.sin(i*0.22)*18+(Math.random()<0.05?155+Math.random()*60:0)+Math.random()*12;
      const imp  = 0.013 + (1-soc)*0.028 + (Math.random()-0.5)*0.003;
      const v    = Math.max(6.1, 12.6*soc - load*imp + (Math.random()-0.5)*0.07);
      dsData.push({t:+t.toFixed(3), v:+v.toFixed(4)});
      // CAN: split total load into ~6 devices
      canData.push({
        t:+t.toFixed(3),
        leftFront_current:   +(load*0.22+(Math.random()-0.5)*2).toFixed(2),
        leftRear_current:    +(load*0.22+(Math.random()-0.5)*2).toFixed(2),
        rightFront_current:  +(load*0.22+(Math.random()-0.5)*2).toFixed(2),
        rightRear_current:   +(load*0.22+(Math.random()-0.5)*2).toFixed(2),
        shooter_outputCurrent:+(load*0.08+(Math.random()-0.5)*1).toFixed(2),
        intake_outputCurrent: +(load*0.04+(Math.random()-0.5)*0.5).toFixed(2),
      });
      soc -= load*1e-7; t += 0.02;
    }
    G.dsFile  = { name: 'demo_match.dslog' };
    G.canFile = { name: 'demo_can.json' };
    G.dsData  = dsData;
    G.canData = extractCANCurrents(canData);
    computeAndRender();
  }, 40);
}

// ═══════════════════════════════════════════════════════════════════
//  SCROLL SPY — highlight active nav link
// ═══════════════════════════════════════════════════════════════════
const sections = ['s-voltage','s-current','s-power','s-impedance'];
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      const id = e.target.id;
      document.querySelectorAll('.tb-link').forEach(a => {
        a.classList.toggle('active', a.getAttribute('href')==='#'+id);
      });
    }
  });
}, { rootMargin:'-40% 0px -55% 0px' });

// Register after page loads
window.addEventListener('load', () => {
  sections.forEach(id => {
    const el=document.getElementById(id); if(el) observer.observe(el);
  });
});
</script>
