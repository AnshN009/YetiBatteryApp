// Threshold h-line plugin
function hLinePlugin(lines) {
  return { afterDraw(chart) {
    lines.forEach(({y,scaleId='y',color,label}) => {
      const sc=chart.scales[scaleId]; if(!sc) return;
      const {ctx,chartArea:ca}=chart, py=sc.getPixelForValue(y);
      if(py<ca.top||py>ca.bottom) return;
      ctx.save();ctx.beginPath();ctx.strokeStyle=color;ctx.lineWidth=1;ctx.setLineDash([4,4]);
      ctx.moveTo(ca.left,py);ctx.lineTo(ca.right,py);ctx.stroke();
      ctx.font='9px IBM Plex Mono';ctx.fillStyle=color;ctx.textAlign='right';
      ctx.fillText(label,ca.right-4,py-3);ctx.restore();
    });
  }};
}

// Downsample to max N points for performance
function ds(arr, max=900) {
  const step = Math.max(1, Math.floor(arr.length/max));
  const out=[]; for(let i=0;i<arr.length;i+=step) out.push(arr[i]);
  return out;
}
function dsIdx(n, max=900) {
  const step=Math.max(1,Math.floor(n/max));
  return Array.from({length:Math.ceil(n/step)},(_,i)=>i*step);
}

