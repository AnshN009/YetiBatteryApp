// ═══════════════════════════════════════════════════════════════════
//  DS LOG PARSER — VOLTAGE ONLY
//  Returns [{t, v}]  sorted by t
// ═══════════════════════════════════════════════════════════════════
function parseDSLog(file, cb) {
  const nm = file.name.toLowerCase();
  if (nm.endsWith('.dslog') || nm.endsWith('.dsevents')) {
    const r = new FileReader();
    r.onload = e => cb(parseDSBinary(new DataView(e.target.result)));
    r.readAsArrayBuffer(file);
  } else {
    const r = new FileReader();
    r.onload = e => cb(parseDSCSV(e.target.result));
    r.readAsText(file);
  }
}

function parseDSBinary(dv) {
  const len = dv.byteLength;
  // Try stride-based decode for known DS Log formats
  for (const stride of [22, 20, 24, 16, 32, 28]) {
    if (len < stride * 20) continue;
    let samples = [], good = 0;
    for (let off = 0; off + stride <= len; off += stride) {
      try {
        const cands = [
          dv.getUint16(off+4, true)/256, dv.getUint16(off+2, true)/256,
          dv.getUint8(off+4)/10,         dv.getUint16(off+6, true)/1000,
          dv.getUint16(off+4, false)/256
        ];
        const v = cands.find(c => c >= 6 && c <= 14.5);
        if (v !== undefined) { good++; samples.push(v); }
      } catch(e) {}
    }
    if (good > len/stride * 0.55 && samples.length > 50) {
      return samples.map((v, i) => ({ t: +(i*0.02).toFixed(3), v: +v.toFixed(4) }));
    }
  }
  // Last resort: scan uint16 LE for voltage-range values
  const found = [];
  for (let off = 0; off+2 <= len; off += 2) {
    const v = dv.getUint16(off, true) / 1000;
    if (v >= 8 && v <= 14) found.push(v);
    if (found.length > 10000) break;
  }
  return found.length > 100 ? found.map((v,i) => ({ t: +(i*0.02).toFixed(3), v: +v.toFixed(4) })) : null;
}

function parseDSCSV(raw) {
  // Auto-detect delimiter, find header, locate voltage column
  const lines = raw.replace(/\r\n/g,'\n').replace(/\r/g,'\n').split('\n').filter(l=>l.trim());
  if (lines.length < 5) return null;
  const samp = lines.slice(0,6).join('\n');
  const tc=(samp.match(/\t/g)||[]).length, cc=(samp.match(/,/g)||[]).length, sc=(samp.match(/;/g)||[]).length;
  const delim = tc>cc&&tc>sc ? '\t' : sc>cc ? ';' : ',';
  const split = l => l.split(delim).map(s=>s.trim().replace(/"/g,''));

  let hIdx=0, hdrs=[];
  for (let i=0; i<Math.min(8,lines.length); i++) {
    const cols = split(lines[i]);
    if (cols.filter(c=>!isNaN(parseFloat(c))&&c!=='').length < cols.length*0.65) { hdrs=cols; hIdx=i; break; }
  }

  const find = (...kws) => {
    for (const kw of kws) {
      const k = kw.toLowerCase().replace(/[^a-z]/g,'');
      const i = hdrs.findIndex(h => h.toLowerCase().replace(/[^a-z]/g,'').includes(k));
      if (i !== -1) return i;
    }
    return -1;
  };

  let iT = find('time','timestamp','elapsed');
  let iV = find('battery','voltage','volt','batt','vbat');

  // Fallback: detect voltage column by value range
  if (iV === -1) {
    const ncols = split(lines[hIdx+1]||lines[0]).length;
    const colS = Array.from({length:ncols}, ()=>[]);
    for (let i=hIdx+1; i<Math.min(hIdx+200,lines.length); i++)
      split(lines[i]).forEach((c,j)=>{const v=parseFloat(c);if(!isNaN(v))colS[j].push(v);});
    for (let j=0; j<ncols; j++) {
      const s=[...colS[j]].sort((a,b)=>a-b), med=s[Math.floor(s.length/2)];
      if (med>=9&&med<=13.5&&s[0]>=5) { iV=j; if(iT===-1&&j>0)iT=0; break; }
    }
  }
  if (iV === -1) return null;

  const data = [];
  for (let i=hIdx+1; i<lines.length; i++) {
    const cols = split(lines[i]);
    const v = parseFloat(cols[iV]);
    if (isNaN(v) || v<3 || v>16) continue;
    const t = iT!==-1 ? parseFloat(cols[iT]) : data.length*0.02;
    data.push({ t: isNaN(t)?data.length*0.02:t, v: +v.toFixed(4) });
  }
  return data.length > 10 ? data : null;
}

// ═══════════════════════════════════════════════════════════════════
//  CAN JSON PARSER — CURRENT SUMMATION
//  Accepts any JSON: array of objects or object with nested arrays
//  Sums all numeric fields that look like current (A) at each timestep
//  Returns [{t, current}]
// ═══════════════════════════════════════════════════════════════════
function parseCANJSON(file, cb) {
  const r = new FileReader();
  r.onload = e => {
    try {
      const text = e.target.result.trim();
      let json;
      try { json = JSON.parse(text); } catch(_) {
        // Try parsing as newline-delimited JSON
        const rows = text.split('\n').filter(l=>l.trim()).map(l=>JSON.parse(l));
        json = rows;
      }
      cb(extractCANCurrents(json));
    } catch(err) {
      console.warn('CAN JSON parse error:', err);
      cb(null);
    }
  };
  r.readAsText(file);
}

function extractCANCurrents(json) {
  // Normalise to array of records
  let records = [];
  if (Array.isArray(json)) {
    records = json;
  } else if (typeof json === 'object') {
    // Maybe {timestamps:[], device1:[], device2:[]} (columnar format)
    if (Array.isArray(json.timestamps) || Array.isArray(json.time) || Array.isArray(json.t)) {
      const times = json.timestamps || json.time || json.t;
      const currentKeys = Object.keys(json).filter(k =>
        k !== 'timestamps' && k !== 'time' && k !== 't' && Array.isArray(json[k])
      );
      records = times.map((t, i) => {
        const rec = { time: t };
        currentKeys.forEach(k => { rec[k] = json[k][i]; });
        return rec;
      });
    } else {
      records = [json]; // single record fallback
    }
  }
  if (!records.length) return null;

  // Heuristic to identify current fields:
  // Names containing: current, amps, amp, output, stator, supply, bus
  // Values in range [-500, 500] A
  const isCurrentKey = k => {
    const lk = k.toLowerCase().replace(/[^a-z]/g,'');
    return ['current','amps','amp','outputcurrent','statorcurrent',
            'supplycurrent','buscurrent','motorcurrent','drawcurrent'].some(kw => lk.includes(kw));
  };

  // Sample first record to find current keys
  const sample = records[0] || {};
  let currentKeys = Object.keys(sample).filter(k => isCurrentKey(k) && typeof sample[k] === 'number');

  // If no named current keys found, try all numeric fields in current range
  if (!currentKeys.length) {
    currentKeys = Object.keys(sample).filter(k => {
      if (k.toLowerCase().replace(/[^a-z]/g,'').includes('time')) return false;
      const v = parseFloat(sample[k]);
      return !isNaN(v) && Math.abs(v) <= 500;
    });
  }

  // Find time key
  const timeKey = Object.keys(sample).find(k => {
    const lk = k.toLowerCase().replace(/[^a-z]/g,'');
    return lk === 'time' || lk === 'timestamp' || lk === 'elapsed' || lk === 't';
  }) || null;

  const data = [];
  records.forEach((rec, idx) => {
    const t = timeKey ? parseFloat(rec[timeKey]) : idx * 0.02;
    if (isNaN(t)) return;
    // Sum all current values, treating negatives as 0 (regenerative braking is not a load)
    let sum = 0;
    currentKeys.forEach(k => {
      const v = parseFloat(rec[k]);
      if (!isNaN(v)) sum += Math.max(0, v);
    });
    data.push({ t: isNaN(t) ? data.length*0.02 : t, current: +sum.toFixed(3) });
  });
  return data.length > 3 ? data : null;
}

// ═══════════════════════════════════════════════════════════════════
//  MERGE DS + CAN onto a common time grid
//  DS log is the master (defines time grid). CAN is resampled to it.
// ═══════════════════════════════════════════════════════════════════
function mergeData(dsData, canData) {
  // Sort both by time
  dsData.sort((a,b) => a.t-b.t);
  if (canData) canData.sort((a,b) => a.t-b.t);

  const times = dsData.map(d => d.t);
  const volts  = dsData.map(d => d.v);
  const dt = times.length > 1 ? (times[times.length-1] - times[0]) / (times.length-1) : 0.02;

  // Interpolate CAN current to DS timestamps
  let currents = [];
  if (canData && canData.length > 3) {
    let ci = 0;
    for (const ds of dsData) {
      // Advance CAN pointer until we straddle ds.t
      while (ci < canData.length-2 && canData[ci+1].t <= ds.t) ci++;
      if (ci >= canData.length-1) {
        currents.push(canData[canData.length-1].current);
      } else if (ds.t <= canData[0].t) {
        currents.push(canData[0].current);
      } else {
        // Linear interpolation
        const a = canData[ci], b = canData[ci+1];
        const frac = b.t === a.t ? 0 : (ds.t - a.t) / (b.t - a.t);
        currents.push(+(a.current + frac*(b.current - a.current)).toFixed(3));
      }
    }
  } else {
    currents = new Array(times.length).fill(NaN);
  }

  return { times, volts, currents, dt };
}

// ═══════════════════════════════════════════════════════════════════
//  ROLLING WINDOW UTILITIES
// ═══════════════════════════════════════════════════════════════════
// All rolling functions are causal (backward-looking window): out[i] uses arr[i-w+1..i]

function rollingMin(arr, w) {
  const out = new Float64Array(arr.length);
  for (let i=0; i<arr.length; i++) {
    let m = Infinity;
    for (let j=Math.max(0,i-w+1); j<=i; j++) m = Math.min(m, arr[j]);
    out[i] = m;
  }
  return out;
}

function rollingMean(arr, w) {
  // O(n) accumulator
  const out = new Float64Array(arr.length);
  let s=0, c=0;
  for (let i=0; i<arr.length; i++) {
    s += arr[i]; c++;
    if (i >= w) { s -= arr[i-w]; c--; }
    out[i] = s/c;
  }
  return out;
}

function rollingMedian(arr, w) {
  // O(n·w) — acceptable for w ≤ 250
  const out = new Float64Array(arr.length);
  for (let i=0; i<arr.length; i++) {
    const win = Array.from(arr.slice(Math.max(0,i-w+1), i+1)).sort((a,b)=>a-b);
    out[i] = win[Math.floor(win.length/2)];
  }
  return out;
}

// ═══════════════════════════════════════════════════════════════════
//  LINEAR REGRESSION
//  Returns {m, b, r2} for y = m*x + b
// ═══════════════════════════════════════════════════════════════════
function linReg(xs, ys) {
  const n = Math.min(xs.length, ys.length);
  if (n < 3) return { m: 0, b: 0, r2: 0 };
  let sx=0, sy=0, sxx=0, sxy=0, syy=0;
  for (let i=0; i<n; i++) {
    sx+=xs[i]; sy+=ys[i]; sxx+=xs[i]*xs[i]; sxy+=xs[i]*ys[i]; syy+=ys[i]*ys[i];
  }
  const denom = n*sxx - sx*sx;
  if (denom === 0) return { m: 0, b: sy/n, r2: 0 };
  const m = (n*sxy - sx*sy)/denom;
  const b = (sy - m*sx)/n;
  const ss_tot = syy - sy*sy/n;
  const ss_res = syy - m*sxy - b*sy;
  const r2 = ss_tot===0 ? 1 : Math.max(0, 1 - ss_res/ss_tot);
  return { m: +m.toFixed(8), b: +b.toFixed(6), r2: +r2.toFixed(4) };
}

function regLine(xs, ys) {
  const reg = linReg(xs, ys);
  if (!xs.length) return { reg, data:[] };
  const x0=xs[0], x1=xs[xs.length-1];
  return { reg, data:[{x:x0,y:reg.m*x0+reg.b},{x:x1,y:reg.m*x1+reg.b}] };
}

function fmtEq(reg, xLabel='t', yLabel='y') {
  const sign = reg.b >= 0 ? '+' : '-';
  return `${yLabel} = ${reg.m.toExponential(3)}·${xLabel} ${sign} ${Math.abs(reg.b).toFixed(4)}  (R²=${reg.r2.toFixed(3)})`;
}

// ═══════════════════════════════════════════════════════════════════
//  LOCAL MAXIMA FINDER
//  Returns indices where arr[i] > arr[i-1] and arr[i] > arr[i+1] and arr[i] > threshold
// ═══════════════════════════════════════════════════════════════════
function localMaxima(arr, threshold = 0, minGap = 5) {
  const peaks = [];
  for (let i=1; i<arr.length-1; i++) {
    if (arr[i] > threshold && arr[i] >= arr[i-1] && arr[i] >= arr[i+1]) {
      // Enforce minimum gap between peaks
      if (!peaks.length || i - peaks[peaks.length-1] >= minGap) peaks.push(i);
    }
  }
  return peaks;
}

// ═══════════════════════════════════════════════════════════════════
//  MAIN ANALYSIS PIPELINE
// ═══════════════════════════════════════════════════════════════════
function runAnalysis() {
  setLoading('Parsing DS log…');
  parseDSLog(G.dsFile, dsData => {
    if (!dsData || dsData.length < 10) {
      setLoading('');
      alert('Could not parse DS log.\n\nMake sure it is a .dslog binary or a CSV with a voltage column (values 6–15 V).');
      return;
    }
    G.dsData = dsData;

    if (G.canFile) {
      setLoading('Parsing CAN JSON…');
      parseCANJSON(G.canFile, canData => {
        G.canData = canData;
        computeAndRender();
      });
    } else {
      G.canData = null;
      computeAndRender();
    }
  });
}

function computeAndRender() {
  setLoading('Computing…');
  setTimeout(() => {
    const { times, volts, currents, dt } = mergeData(G.dsData, G.canData);
    G.times = times; G.volts = volts; G.currents = currents; G.dt = dt;
    const n = times.length;
    const hasCurr = currents.some(c => !isNaN(c) && c > 0);

    // OCV: mean of top 3% of voltage samples
    const sortedV = [...volts].sort((a,b)=>b-a);
    const topN = Math.max(3, Math.floor(n*0.03));
    const ocv = sortedV.slice(0,topN).reduce((a,b)=>a+b,0)/topN;
    G.ocv = ocv;

    // Power array
    const power = volts.map((v,i) => hasCurr&&!isNaN(currents[i]) ? Math.max(0, v*currents[i]) : NaN);
    G.power = power;

    // Impedance samples: only at current local maxima with I > 15A
    const safeCurr = currents.map(c => isNaN(c)?0:Math.max(0,c));
    const peakIdxC = localMaxima(safeCurr, I_MIN_IMPEDANCE, Math.max(1, Math.round(0.1/dt)));
    const impSamples = peakIdxC.map(idx => {
      const sag = Math.max(0, ocv - volts[idx]);
      const R = safeCurr[idx] > 0 ? sag / safeCurr[idx] : NaN;
      return { idx, t: times[idx], v: volts[idx], c: safeCurr[idx], sag, R: R*1000 }; // R in mΩ
    }).filter(s => !isNaN(s.R) && s.R > 0 && s.R < 150);
    G.impSamples = impSamples;

    // Current peaks (for scatter)
    const peakIdxAll = localMaxima(safeCurr, 30, Math.max(1, Math.round(0.1/dt)));

    // ── Store all computed data for CSV export ────────────────────
    const defaultWindow = 5; // samples = 0.1s at 50Hz
    const rollV  = rollingMin(new Float64Array(volts), defaultWindow);
    const rollC  = hasCurr ? rollingMean(new Float64Array(safeCurr), defaultWindow) : null;
    const rollP  = hasCurr ? rollingMean(new Float64Array(power.map(p=>isNaN(p)?0:p)), defaultWindow) : null;
    const impArr = impSamples.map(s=>s.R);
    const impTimes = impSamples.map(s=>s.t);

    CHART_DATA = {
      times, volts, rollV: Array.from(rollV),
      currents, safeCurr, rollC: rollC?Array.from(rollC):null,
      power, rollP: rollP?Array.from(rollP):null,
      impSamples, peakIdxC, peakIdxAll, ocv, hasCurr, dt, n
    };

    // ── Stats ────────────────────────────────────────────────────
    renderStats(volts, safeCurr, power, impSamples, hasCurr, ocv, dt, n);

    // ── Render charts ─────────────────────────────────────────────
    destroyCharts();
    renderVChart(defaultWindow);
    renderCChart(defaultWindow, peakIdxAll);
    renderPChart(defaultWindow);
    renderIChart(defaultWindow);

    // Update new-files bar
    document.getElementById('nf-ds-name').textContent = G.dsFile?.name || 'DS log';
    document.getElementById('nf-ds').classList.add('loaded');
    if (G.canFile) {
