<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>FRC Battery Analyzer</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
/* ── TOKENS ── */
:root{
  --bg:#07090e; --bg2:#0c0f18; --bg3:#11151f; --card:#0d1019;
  --bord:rgba(255,255,255,0.06); --bord2:rgba(255,255,255,0.12);
  --txt:#cdd3e8; --mut:#47506a; --mut2:#6a7490;
  --grn:#00dfa0; --grn2:rgba(0,223,160,0.09);
  --ylw:#f0b429; --red:#ff4040; --blu:#3d8fff;
  --ora:#ff6e1a; --pur:#a78bfa; --cya:#22d3ee;
  --mono:'IBM Plex Mono',monospace;
  --sans:'IBM Plex Sans',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--txt);font-family:var(--sans);font-weight:300;min-height:100vh}
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,223,160,0.006) 3px,rgba(0,223,160,0.006) 4px)}

/* ── PAGES ── */
.page{display:none;position:relative;z-index:1;min-height:100vh}
.page.active{display:block}

/* ════════════════════════════════════════
   LANDING PAGE
════════════════════════════════════════ */
#landing{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  min-height:100vh;padding:48px 24px;
}
.land-logo{
  font-family:var(--mono);font-size:11px;letter-spacing:0.2em;color:var(--grn);
  text-transform:uppercase;margin-bottom:32px;
}
.land-logo span{color:var(--mut2)}
.land-title{font-size:36px;font-weight:500;letter-spacing:-0.5px;margin-bottom:12px;text-align:center}
.land-sub{font-size:14px;color:var(--mut2);line-height:1.8;text-align:center;max-width:540px;margin-bottom:48px}
.land-sub strong{color:var(--txt);font-weight:500}

/* Upload cards */
.upload-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;width:100%;max-width:700px;margin-bottom:28px}
@media(max-width:580px){.upload-grid{grid-template-columns:1fr}}
.upload-card{
  background:var(--bg2);border:1px solid var(--bord2);border-radius:10px;
  padding:24px;cursor:pointer;transition:border-color .2s,background .2s;
  display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;
}
.upload-card:hover{border-color:var(--grn);background:var(--bg3)}
.upload-card.has-file{border-color:var(--grn);background:rgba(0,223,160,0.05)}
.upload-card.optional:hover{border-color:var(--ylw)}
.upload-card.optional.has-file{border-color:var(--ylw)}
.uc-icon{font-size:32px}
.uc-label{font-family:var(--mono);font-size:9px;letter-spacing:0.12em;text-transform:uppercase;
  color:var(--grn);margin-bottom:2px}
.upload-card.optional .uc-label{color:var(--ylw)}
.uc-title{font-size:15px;font-weight:500}
.uc-sub{font-size:12px;color:var(--mut2);line-height:1.6}
.uc-sub code{font-family:var(--mono);font-size:11px;color:var(--grn);background:var(--grn2);padding:1px 5px;border-radius:3px}
.upload-card.optional .uc-sub code{color:var(--ylw);background:rgba(240,180,41,0.09)}
.uc-filename{font-family:var(--mono);font-size:11px;color:var(--grn);margin-top:4px;word-break:break-all}
.upload-card.optional .uc-filename{color:var(--ylw)}
input[type=file]{display:none}

.land-analyze{
  padding:13px 44px;background:var(--grn2);border:1px solid rgba(0,223,160,0.4);
  border-radius:6px;color:var(--grn);font-family:var(--sans);font-size:15px;font-weight:500;
  cursor:pointer;transition:all .15s;letter-spacing:0.02em;
}
.land-analyze:hover:not(:disabled){background:rgba(0,223,160,0.18)}
.land-analyze:disabled{opacity:0.35;cursor:not-allowed}
.land-demo{
  margin-top:14px;background:none;border:1px solid var(--bord2);
  border-radius:6px;color:var(--mut2);font-family:var(--sans);font-size:13px;
  padding:8px 24px;cursor:pointer;transition:all .15s;
}
.land-demo:hover{border-color:var(--bord2);color:var(--txt)}

.land-hints{margin-top:36px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;max-width:700px;width:100%}
@media(max-width:580px){.land-hints{grid-template-columns:1fr}}
.hint-card{background:var(--bg2);border:1px solid var(--bord);border-radius:6px;padding:14px 16px}
.hint-card h4{font-family:var(--mono);font-size:9px;letter-spacing:0.12em;color:var(--grn);text-transform:uppercase;margin-bottom:7px}
.hint-card p{font-size:12px;color:var(--mut2);line-height:1.65}
.hint-card code{font-family:var(--mono);font-size:11px;color:var(--ylw)}

/* ════════════════════════════════════════
   ANALYSIS PAGE
════════════════════════════════════════ */
#analysis{padding:0}

/* Sticky top bar */
.topbar{
  position:sticky;top:0;z-index:200;
  background:rgba(7,9,14,0.96);backdrop-filter:blur(14px);
  border-bottom:1px solid var(--bord);
  padding:10px 28px;display:flex;align-items:center;gap:16px;
}
.tb-logo{font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:0.16em;color:var(--grn);text-transform:uppercase;flex-shrink:0}
.tb-logo span{color:var(--mut2);font-weight:400}
.tb-nav{display:flex;gap:0;overflow-x:auto;flex:1}
.tb-nav::-webkit-scrollbar{display:none}
.tb-link{
  font-family:var(--mono);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;
  color:var(--mut2);padding:10px 16px;text-decoration:none;
  border-bottom:2px solid transparent;transition:all .15s;white-space:nowrap;flex-shrink:0;
}
.tb-link:hover{color:var(--txt)}
.tb-link.active{color:var(--grn);border-bottom-color:var(--grn)}
.tb-btns{display:flex;gap:8px;margin-left:auto;flex-shrink:0}
.btn{
  display:inline-flex;align-items:center;gap:6px;padding:7px 14px;
  border:1px solid var(--bord2);border-radius:4px;background:var(--bg3);
  color:var(--txt);font-family:var(--sans);font-size:12px;font-weight:400;
  cursor:pointer;transition:all .15s;white-space:nowrap;
}
.btn:hover{border-color:var(--grn);color:var(--grn)}
.btn.p{border-color:rgba(0,223,160,0.4);color:var(--grn);background:var(--grn2)}

/* Sections */
.section{
  max-width:1300px;margin:0 auto;padding:40px 28px 60px;
  border-bottom:1px solid var(--bord);
  scroll-margin-top:56px;
}
.section:last-child{border-bottom:none}

.sec-header{display:flex;align-items:center;gap:14px;margin-bottom:24px}
.sec-num{
  font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:0.08em;
  color:var(--grn);background:var(--grn2);border:1px solid rgba(0,223,160,0.25);
  padding:3px 10px;border-radius:3px;
}
.sec-title{font-size:22px;font-weight:500;letter-spacing:-0.3px}
.sec-sub{font-size:13px;color:var(--mut2);line-height:1.7;margin-bottom:20px}
.sec-sub strong{color:var(--txt);font-weight:500}

/* Controls row */
.controls{
  display:flex;align-items:center;flex-wrap:wrap;gap:14px;
  background:var(--bg2);border:1px solid var(--bord);border-radius:6px;
  padding:14px 18px;margin-bottom:14px;
}
.ctrl-group{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.ctrl-label{font-family:var(--mono);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:var(--mut);white-space:nowrap}

/* Toggle buttons */
.tog{
  font-family:var(--mono);font-size:10px;padding:4px 12px;border-radius:4px;
  border:1px solid var(--bord2);background:transparent;color:var(--mut2);
  cursor:pointer;transition:all .15s;white-space:nowrap;
}
.tog:hover{border-color:var(--bord2);color:var(--txt)}
.tog.on{color:var(--bg);font-weight:500}

/* Rolling window slider */
.slider-wrap{display:flex;align-items:center;gap:10px}
.slider-wrap input[type=range]{
  -webkit-appearance:none;width:120px;height:4px;
  border-radius:2px;background:var(--bg3);outline:none;cursor:pointer;
}
.slider-wrap input[type=range]::-webkit-slider-thumb{
  -webkit-appearance:none;width:14px;height:14px;border-radius:50%;
  background:var(--grn);cursor:pointer;
}
.slider-val{font-family:var(--mono);font-size:11px;color:var(--grn);min-width:36px}

/* Equation display */
.eq-box{
  font-family:var(--mono);font-size:12px;color:var(--ylw);
  background:rgba(240,180,41,0.08);border:1px solid rgba(240,180,41,0.2);
  border-radius:4px;padding:6px 14px;white-space:nowrap;
}

/* Chart card */
.chart-card{background:var(--card);border:1px solid var(--bord);border-radius:8px;padding:20px 22px;margin-bottom:14px}
.chart-card h3{font-family:var(--mono);font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:var(--mut2);margin-bottom:3px}
.chart-card .csub{font-size:11px;color:var(--mut);margin-bottom:14px;line-height:1.5}
.chart-wrap{position:relative}

/* Stat row */
.stat-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:9px;margin-bottom:14px}
.stat{background:var(--card);border:1px solid var(--bord);border-radius:5px;padding:13px 16px;border-left:2px solid var(--sl,transparent)}
.stat.g{--sl:var(--grn)}.stat.y{--sl:var(--ylw)}.stat.r{--sl:var(--red)}.stat.b{--sl:var(--blu)}.stat.p{--sl:var(--pur)}
.stat-lbl{font-family:var(--mono);font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--mut);margin-bottom:8px}
.stat-val{font-family:var(--mono);font-size:22px;font-weight:600;line-height:1;color:var(--txt)}
.stat-unit{font-size:11px;font-weight:400;color:var(--mut2);margin-left:1px}
.stat-note{font-size:11px;color:var(--mut);margin-top:5px;line-height:1.4}

/* Download button */
.dl-btn{
  display:inline-flex;align-items:center;gap:7px;
  padding:8px 18px;border:1px solid var(--bord2);border-radius:5px;
  background:var(--bg3);color:var(--mut2);font-family:var(--mono);
  font-size:10px;letter-spacing:0.06em;text-transform:uppercase;
  cursor:pointer;transition:all .15s;margin-top:8px;
}
.dl-btn:hover{border-color:var(--grn);color:var(--grn)}

/* Legend inline */
.legend{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:10px}
.leg{display:flex;align-items:center;gap:5px;font-family:var(--mono);font-size:10px;color:var(--mut2)}
.leg-line{width:20px;height:2px}
.leg-dot{width:8px;height:8px;border-radius:50%}

/* Loading overlay */
#loadOverlay{
  display:none;position:fixed;inset:0;z-index:500;
  background:rgba(7,9,14,0.88);backdrop-filter:blur(8px);
  align-items:center;justify-content:center;flex-direction:column;gap:16px;
  font-family:var(--mono);font-size:13px;color:var(--grn);
}
#loadOverlay.show{display:flex}
.spinner{width:32px;height:32px;border:2px solid var(--bord2);border-top-color:var(--grn);border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* New files panel */
.new-files-bar{
  background:var(--bg2);border-bottom:1px solid var(--bord);
  padding:14px 28px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  max-width:1300px;margin:0 auto;
}
.nf-label{font-family:var(--mono);font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--mut)}
.nf-slot{
  display:flex;align-items:center;gap:8px;
  background:var(--bg3);border:1px solid var(--bord2);border-radius:5px;
  padding:6px 12px;cursor:pointer;transition:border-color .15s;
}
.nf-slot:hover{border-color:var(--grn)}
.nf-slot-name{font-family:var(--mono);font-size:11px;color:var(--mut2)}
.nf-slot.loaded .nf-slot-name{color:var(--grn)}
</style>
</head>
<body>

<!-- ══════════════════════════════════════════════
     LANDING PAGE
══════════════════════════════════════════════ -->
<div id="landing" class="page active">
  <div class="land-logo">FRC <span>//</span> Battery Analyzer</div>
  <div class="land-title">Match Battery Analysis</div>
  <div class="land-sub">
    Upload your <strong>DS Log</strong> (voltage source) and <strong>CAN JSON</strong> (current source) from the RoboRIO.
    Current is computed as the sum of all device currents on the CAN bus — more accurate than battery-side measurement alone.
  </div>

  <div class="upload-grid">
    <!-- DS Log -->
    <div class="upload-card" id="card-ds" onclick="document.getElementById('input-ds').click()">
      <div class="uc-icon">📋</div>
      <div class="uc-label">Required</div>
      <div class="uc-title">DS Log</div>
      <div class="uc-sub">
        <code>.dslog</code> binary or <code>.csv</code> export.<br>
        Provides battery voltage data at ~50 Hz.
      </div>
      <div class="uc-filename" id="ds-filename">No file selected</div>
    </div>
    <input type="file" id="input-ds" accept="*">

    <!-- CAN JSON -->
    <div class="upload-card optional" id="card-can" onclick="document.getElementById('input-can').click()">
      <div class="uc-icon">🔌</div>
      <div class="uc-label">Required for current</div>
      <div class="uc-title">CAN JSON</div>
      <div class="uc-sub">
        JSON array from RoboRIO CAN bus logging.<br>
        Each record has device currents — <code>current</code>, <code>outputCurrent</code>, or similar.
      </div>
      <div class="uc-filename" id="can-filename">No file selected</div>
    </div>
    <input type="file" id="input-can" accept=".json,.txt,.csv,*">
  </div>

  <button class="land-analyze" id="analyzeBtn" disabled onclick="runAnalysis()">⚡ Analyze</button>
  <button class="land-demo" onclick="runDemo()">Load demo match data</button>

  <div class="land-hints">
    <div class="hint-card">
      <h4>DS Log export</h4>
      <p>DS Log File Viewer → select log → <code>File → Export CSV</code>. The raw <code>.dslog</code> binary also works — voltage is extracted via stride-based decode.</p>
    </div>
    <div class="hint-card">
      <h4>CAN JSON format</h4>
      <p>Log each CAN device's current via WPILib or Advantage Scope. Expected: a JSON array where each object has a <code>time</code> field and one or more current fields per device (e.g. <code>leftDrive_current</code>, <code>shooter_outputCurrent</code>).</p>
    </div>
    <div class="hint-card">
      <h4>Why sum CAN currents?</h4>
      <p>The battery-side current measurement includes regenerative effects and sensor noise. Summing per-device CAN currents gives a cleaner picture of what your robot actually demands at each moment.</p>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════
     ANALYSIS PAGE
══════════════════════════════════════════════ -->
<div id="analysis" class="page">

  <!-- Sticky nav -->
  <div class="topbar">
    <div class="tb-logo">FRC <span>//</span> Battery</div>
    <nav class="tb-nav">
      <a class="tb-link active" href="#s-voltage" onclick="setActiveNav(this)">① Voltage</a>
      <a class="tb-link" href="#s-current" onclick="setActiveNav(this)">② Current</a>
      <a class="tb-link" href="#s-power" onclick="setActiveNav(this)">③ Power</a>
      <a class="tb-link" href="#s-impedance" onclick="setActiveNav(this)">④ Impedance</a>
    </nav>
    <div class="tb-btns">
      <button class="btn p" onclick="goBack()">⬆ New files</button>
    </div>
  </div>

  <!-- New files quick-swap bar -->
  <div class="new-files-bar">
    <span class="nf-label">Loaded files:</span>
    <div class="nf-slot" id="nf-ds" onclick="document.getElementById('nf-input-ds').click()">
      <span>📋</span><span class="nf-slot-name" id="nf-ds-name">No DS log</span>
    </div>
    <input type="file" id="nf-input-ds" accept="*" onchange="swapFile('ds',this)">
    <div class="nf-slot" id="nf-can" onclick="document.getElementById('nf-input-can').click()">
      <span>🔌</span><span class="nf-slot-name" id="nf-can-name">No CAN JSON</span>
    </div>
    <input type="file" id="nf-input-can" accept=".json,.txt,.csv,*" onchange="swapFile('can',this)">
    <button class="btn" onclick="rerun()" id="rerunBtn" style="display:none">↻ Re-analyze</button>
  </div>

  <!-- ① VOLTAGE -->
  <section class="section" id="s-voltage">
    <div class="sec-header">
      <span class="sec-num">01</span>
      <span class="sec-title">Voltage</span>
    </div>
    <div class="sec-sub">
      Voltage sourced from the DS log. <strong>Rolling window</strong> uses a causal minimum (worst-case dip) to expose brownout events.
      The <strong>regression line</strong> shows the overall depletion trend. Click the legend buttons to show/hide each series.
    </div>

    <div class="stat-row" id="vStats"></div>

    <div class="controls">
      <div class="ctrl-group">
        <span class="ctrl-label">Show</span>
        <button class="tog on" id="tog-v-raw"  style="--tc:var(--grn)"  onclick="toggleLine('v','raw')">Raw voltage</button>
        <button class="tog on" id="tog-v-roll" style="--tc:var(--ylw)"  onclick="toggleLine('v','roll')">Rolling min</button>
        <button class="tog on" id="tog-v-reg"  style="--tc:var(--pur)"  onclick="toggleLine('v','reg')">Regression</button>
      </div>
      <div class="ctrl-group">
        <span class="ctrl-label">Window</span>
        <div class="slider-wrap">
          <input type="range" id="slider-v" min="1" max="250" value="5" oninput="updateRolling('v',this.value)">
          <span class="slider-val" id="slider-v-lbl">0.1s</span>
        </div>
      </div>
      <div class="eq-box" id="eq-v">Regression: —</div>
    </div>

    <div class="chart-card">
      <h3>Voltage over time</h3>
      <div class="csub">DS log terminal voltage. Horizontal dashed lines: 6.3V radio brownout · 8.5V motor torque loss.</div>
      <div class="chart-wrap" style="height:320px"><canvas id="chartV"></canvas></div>
    </div>

    <button class="dl-btn" onclick="downloadCSV('voltage')">⬇ Download voltage data (.csv)</button>
  </section>

  <!-- ② CURRENT -->
  <section class="section" id="s-current">
    <div class="sec-header">
      <span class="sec-num">02</span>
      <span class="sec-title">Current</span>
    </div>
    <div class="sec-sub">
      Current is the <strong>sum of all device currents</strong> from the CAN JSON — one reading per timestep.
      Relative maxima (local peaks) are plotted as a scatter to visualise spike events. The regression is fitted to those peaks.
    </div>

    <div class="stat-row" id="cStats"></div>

    <div class="controls">
      <div class="ctrl-group">
        <span class="ctrl-label">Show</span>
        <button class="tog on" id="tog-c-raw"   onclick="toggleLine('c','raw')">Raw current</button>
        <button class="tog on" id="tog-c-roll"  onclick="toggleLine('c','roll')">Rolling mean</button>
        <button class="tog on" id="tog-c-peaks" onclick="toggleLine('c','peaks')">Peak scatter</button>
        <button class="tog on" id="tog-c-reg"   onclick="toggleLine('c','reg')">Regression (peaks)</button>
      </div>
      <div class="ctrl-group">
        <span class="ctrl-label">Window</span>
        <div class="slider-wrap">
          <input type="range" id="slider-c" min="1" max="250" value="5" oninput="updateRolling('c',this.value)">
          <span class="slider-val" id="slider-c-lbl">0.1s</span>
        </div>
      </div>
      <div class="eq-box" id="eq-c">Regression: —</div>
    </div>

    <div class="chart-card">
      <h3>Current over time</h3>
      <div class="csub">Summed CAN device currents. Scatter = local maxima above 30A. Dashed: 120A main breaker · 160A critical.</div>
      <div class="chart-wrap" style="height:320px"><canvas id="chartC"></canvas></div>
    </div>

    <button class="dl-btn" onclick="downloadCSV('current')">⬇ Download current data (.csv)</button>
  </section>

  <!-- ③ POWER -->
  <section class="section" id="s-power">
    <div class="sec-header">
      <span class="sec-num">03</span>
      <span class="sec-title">Power</span>
    </div>
    <div class="sec-sub">
      Instantaneous power P = V × I using DS log voltage and summed CAN current.
      The regression line shows whether power demand trends up (battery sagging, motors drawing more) or remains flat.
    </div>

    <div class="stat-row" id="pStats"></div>

    <div class="controls">
      <div class="ctrl-group">
        <span class="ctrl-label">Show</span>
        <button class="tog on" id="tog-p-raw"  onclick="toggleLine('p','raw')">Raw power</button>
        <button class="tog on" id="tog-p-roll" onclick="toggleLine('p','roll')">Rolling mean</button>
        <button class="tog on" id="tog-p-reg"  onclick="toggleLine('p','reg')">Regression</button>
      </div>
      <div class="ctrl-group">
        <span class="ctrl-label">Window</span>
        <div class="slider-wrap">
          <input type="range" id="slider-p" min="1" max="250" value="25" oninput="updateRolling('p',this.value)">
          <span class="slider-val" id="slider-p-lbl">0.5s</span>
        </div>
      </div>
      <div class="eq-box" id="eq-p">Regression: —</div>
    </div>

    <div class="chart-card">
      <h3>Power over time</h3>
      <div class="csub">P = V × I. Dashed: 1500W sustained warning.</div>
