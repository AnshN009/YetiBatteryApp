//  STATS CARDS
// ═══════════════════════════════════════════════════════════════════
function S(label, val, unit, note, cls) {
  return `<div class="stat ${cls}">
    <div class="stat-lbl">${label}</div>
    <div class="stat-val">${val}<span class="stat-unit">${unit}</span></div>
    <div class="stat-note">${note}</div>
  </div>`;
}
const f2=v=>isNaN(v)||v==null?'—':(+v).toFixed(2);
const f1=v=>isNaN(v)||v==null?'—':(+v).toFixed(1);
const f0=v=>isNaN(v)||v==null?'—':Math.round(+v);

function renderStats(volts, curr, power, impSamples, hasCurr, ocv, dt, n) {
  const vMin=Math.min(...volts), vMax=Math.max(...volts), vMean=volts.reduce((a,b)=>a+b)/n;
  const nBelow85=volts.filter(v=>v<8.5).length, nBelow63=volts.filter(v=>v<6.3).length;
  document.getElementById('vStats').innerHTML =
    S('Min voltage',     f2(vMin),  'V', 'Lowest single sample',      vMin>=8.5?'g':vMin>=7.5?'y':'r')+
    S('OCV estimate',    f2(ocv),   'V', 'Top-3% sample average',     'b')+
    S('Mean voltage',    f2(vMean), 'V', 'Average across match',      vMean>=11?'g':vMean>=10?'y':'r')+
    S('< 8.5V time',     f2(nBelow85*dt),'s','Motor torque loss zone',nBelow85===0?'g':nBelow85<50?'y':'r')+
    S('< 6.3V time',     f2(nBelow63*dt),'s','Radio brownout zone',   nBelow63===0?'g':'r');

  if (hasCurr) {
    const cValid=curr.filter(c=>c>0);
    const cMax=Math.max(...cValid)||0, cMean=cValid.reduce((a,b)=>a+b,0)/(cValid.length||1);
    document.getElementById('cStats').innerHTML =
      S('Peak current',   f1(cMax),    'A', 'Highest CAN sum sample',   cMax<120?'g':cMax<160?'y':'r')+
      S('Mean current',   f1(cMean),   'A', 'Average demand',           cMean<60?'g':cMean<90?'y':'r')+
      S('> 120A samples', curr.filter(c=>c>120).length,'','Above main breaker threshold',curr.filter(c=>c>120).length===0?'g':'r')+
      S('CAN devices',    '—',         '',  'Devices summed from JSON',  'b');
    const pValid=power.filter(p=>!isNaN(p)&&p>0);
    const pMax=Math.max(...pValid)||0, pMean=pValid.reduce((a,b)=>a+b,0)/(pValid.length||1);
    const totalWh=pValid.reduce((a,b)=>a+b,0)*dt/3600;
    document.getElementById('pStats').innerHTML =
      S('Peak power',     f0(pMax),    'W',  'Highest instantaneous W',  pMax<2000?'g':pMax<3000?'y':'r')+
      S('Mean power',     f0(pMean),   'W',  'Average demand',           pMean<800?'g':pMean<1200?'y':'r')+
      S('Total energy',   f2(totalWh), 'Wh', 'Used this match',          totalWh<108?'g':totalWh<151?'y':'r')+
      S('% of 216Wh',     f1(totalWh/216*100),'%','Battery capacity used',totalWh/216<0.5?'g':totalWh/216<0.7?'y':'r');
  } else {
    document.getElementById('cStats').innerHTML=`<div style="color:var(--mut);font-family:var(--mono);font-size:12px;padding:12px">No CAN JSON loaded — current data unavailable.</div>`;
    document.getElementById('pStats').innerHTML=`<div style="color:var(--mut);font-family:var(--mono);font-size:12px;padding:12px">No CAN JSON loaded — power data unavailable.</div>`;
  }
  if (impSamples.length > 3) {
    const Rs = impSamples.map(s=>s.R).sort((a,b)=>a-b);
    const medR = Rs[Math.floor(Rs.length/2)];
    const p90R = Rs[Math.floor(Rs.length*0.9)];
    const ccaEst = medR>0 ? Math.round(7200/medR) : NaN; // 7200 = 7.2Ω × 1000mΩ/Ω
    document.getElementById('iStats').innerHTML =
      S('Median R',       f1(medR),    'mΩ', 'Representative resistance', medR<=18?'g':medR<=28?'y':'r')+
      S('P90 R',          f1(p90R),    'mΩ', 'Under heavy current',       p90R<=25?'g':p90R<=40?'y':'r')+
      S('Spike factor',   f1(p90R/medR),'×', 'P90/Median',                p90R/medR<=2?'g':p90R/medR<=3.5?'y':'r')+
      S('Est. CCA',       f0(ccaEst),  'A',  '7200/R_median empirical',   isNaN(ccaEst)?'':ccaEst>=400?'g':ccaEst>=260?'y':'r')+
      S('R samples',      impSamples.length,'','I>15A peak samples used', 'b');
  } else {
    document.getElementById('iStats').innerHTML=`<div style="color:var(--mut);font-family:var(--mono);font-size:12px;padding:12px">Not enough high-current samples for impedance analysis.</div>`;
  }
}

