// ═══════════════════════════════════════════════════════════════════
function sliderToWindow(val) {
  // Map 1–250 slider → 1–250 samples (0.02s–5.0s at 50Hz)
  return Math.max(1, Math.round(+val));
}
function windowLabel(w, dt) {
  const s = w * dt;
  return s < 1 ? `${(s).toFixed(2)}s` : `${s.toFixed(1)}s`;
}

function updateRolling(chartKey, sliderVal) {
  const w = sliderToWindow(sliderVal);
  const dt = CHART_DATA.dt || 0.02;
  document.getElementById(`slider-${chartKey}-lbl`).textContent = windowLabel(w, dt);

  if (chartKey === 'v') {
    if (!CH.v) return;
    const rollV = Array.from(rollingMin(new Float64Array(CHART_DATA.volts), w));
    const step=Math.max(1,Math.floor(CHART_DATA.times.length/900));
    const RV=[]; for(let i=0;i<CHART_DATA.times.length;i+=step) RV.push(+rollV[i].toFixed(4));
    CH.v.data.datasets[1].data = RV;
    CH.v.update('none');

  } else if (chartKey === 'c') {
    if (!CH.c||!CHART_DATA.hasCurr) return;
    const rollC = Array.from(rollingMean(new Float64Array(CHART_DATA.safeCurr), w));
    const step=Math.max(1,Math.floor(CHART_DATA.times.length/900));
    const RC=[]; for(let i=0;i<CHART_DATA.times.length;i+=step) RC.push(+rollC[i].toFixed(2));
    CH.c.data.datasets[1].data = RC;
    CH.c.update('none');

  } else if (chartKey === 'p') {
    if (!CH.p||!CHART_DATA.hasCurr) return;
    const safePow=CHART_DATA.power.map(p=>isNaN(p)?0:p);
    const rollP = Array.from(rollingMean(new Float64Array(safePow), w));
    const step=Math.max(1,Math.floor(CHART_DATA.times.length/900));
    const RP=[]; for(let i=0;i<CHART_DATA.times.length;i+=step) RP.push(+rollP[i].toFixed(1));
    CH.p.data.datasets[1].data = RP;
    CH.p.update('none');

  } else if (chartKey === 'i') {
    if (!CH.i||!CHART_DATA.impSamples.length) return;
    const iR = CHART_DATA.impSamples.map(s=>s.R);
    const rollI = Array.from(rollingMedian(new Float64Array(iR), Math.max(1,w)));
    CH.i.data.datasets[1].data = rollI;
    CH.i.update('none');
  }
}

